#include <iostream>
#include <thread>
using namespace std;
// Shared variables for Peterson's Algorithm
bool flag[2] = {false, false};
int turn;
// Process 0
void process0()
{
    flag[0] = true;
    turn = 1;
    // Wait until Process 1 leaves critical section
    while (flag[1] && turn == 1);
    cout << "Process 0 in critical section" << endl;
    flag[0] = false;
}
// Process 1
void process1()
{
    flag[1] = true;
    turn = 0;
    // Wait until Process 0 leaves critical section
    while (flag[0] && turn == 0);

    cout << "Process 1 in critical section" << endl;

    flag[1] = false;
}
int main()
{
    thread t1(process0);
    thread t2(process1);
    t1.join();
    t2.join();

    return 0;
}
